SELECT
    e.name AS genre,
    COUNT(c.rental_id) AS total_rentals,
    SUM(d.amount) AS total_revenue
FROM
    film a
JOIN inventory b ON a.film_id = b.film_id
JOIN rental c ON b.inventory_id = c.inventory_id
JOIN payment d ON c.rental_id = d.rental_id
JOIN film_category f ON a.film_id = f.film_id
JOIN category e ON f.category_id = e.category_id
GROUP BY
    e.name
ORDER BY
    SUM(d.amount) DESC;
